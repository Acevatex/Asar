// The single path inside the archive that replacement is restricted to.
// Use forward slashes. May be:
//   - an exact file, e.g. "src/app/main/index.js"  -> only that file
//   - a directory,   e.g. "src/app/main"           -> everything under it
static const std::string kOnlyTarget = "src/app/main/index.js";

// Returns true if `relStr` (forward-slash relative path from the unpack
// root) is the target itself or lives underneath it.
static bool matchesOnlyTarget(const std::string& relStr) {
    if (relStr == kOnlyTarget) return true;
    if (relStr.size() > kOnlyTarget.size() &&
        relStr.compare(0, kOnlyTarget.size(), kOnlyTarget) == 0 &&
        relStr[kOnlyTarget.size()] == '/') {
        return true;
    }
    return false;
}

// Applies every pair in `patches` (in order) to a single file's content.
// Returns the total number of replacements made across all pairs.
static size_t replacePatchesInFile(const fs::path& path,
    const std::vector<std::pair<std::string, std::string>>& patches) {
    std::ifstream in(path, std::ios::binary);
    std::string content((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
    in.close();

    size_t totalCount = 0;

    for (auto& pr : patches) {
        const std::string& from = pr.first;
        const std::string& to = pr.second;
        if (from.empty()) continue;

        size_t pos = 0;
        std::string result;
        result.reserve(content.size());
        size_t count = 0;
        while (true) {
            size_t found = content.find(from, pos);
            if (found == std::string::npos) {
                result.append(content, pos, std::string::npos);
                break;
            }
            result.append(content, pos, found - pos);
            result.append(to);
            pos = found + from.size();
            count++;
        }
        if (count > 0) {
            content = std::move(result);
            totalCount += count;
        }
    }

    if (totalCount > 0) {
        std::ofstream out(path, std::ios::binary | std::ios::trunc);
        out.write(content.data(), (std::streamsize)content.size());
    }
    return totalCount;
}

// Kept for the standalone "replace" command (single search/replace pair).
static size_t replaceInFile(const fs::path& path, const std::string& from, const std::string& to) {
    return replacePatchesInFile(path, { { from, to } });
}

static void walkReplace(const fs::path& dir,
    const std::vector<std::pair<std::string, std::string>>& patches,
    bool all, const std::vector<std::string>& exts) {
    size_t totalFiles = 0, totalReplacements = 0;
    bool sawTarget = false;

    for (auto& entry : fs::recursive_directory_iterator(dir)) {
        if (!entry.is_regular_file()) continue;

        // Path of this file relative to the unpack root, forward-slash form,
        // so it lines up with kOnlyTarget regardless of platform.
        std::string relStr = fs::relative(entry.path(), dir).generic_string();

        if (!matchesOnlyTarget(relStr)) continue;
        sawTarget = true;

        std::string ext = entry.path().extension().string();
        std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);

        bool shouldProcess = all || std::find(exts.begin(), exts.end(), ext) != exts.end();
        if (!shouldProcess) continue;

        size_t n = replacePatchesInFile(entry.path(), patches);
        if (n > 0) {
            totalFiles++;
            totalReplacements += n;
        }
    }

    if (!sawTarget) {
        std::cerr << "Warning: target path \"" << kOnlyTarget
            << "\" was not found inside the archive - nothing was touched.\n";
    }
}

// -------------------------------- main -------------------------------------

static std::vector<std::string> splitExts(const std::string& csv) {
    std::vector<std::string> out;
    std::stringstream ss(csv);
    std::string item;
    while (std::getline(ss, item, ',')) {
        std::transform(item.begin(), item.end(), item.begin(), ::tolower);
        out.push_back(item);
    }
    return out;
}

int main(int argc, char** argv) {
    try {
        // Optional positional path argument. If the next arg is missing
        // or looks like a flag, default to "app.asar" in the current
        // working directory.
        int nextArgIdx = 2;
        fs::path asarPath;
        if (argc > 2 && std::string(argv[2]).rfind("--", 0) != 0) {
            asarPath = argv[2];
            nextArgIdx = 3;
        }
        else {
            asarPath = fs::current_path() / "app.asar";
        }

        bool all = false;
        std::vector<std::string> exts = kDefaultTextExtensions;
        for (int i = nextArgIdx; i < argc; i++) {
            std::string a = argv[i];
            if (a == "--all") all = true;
            else if (a.rfind("--ext", 0) == 0 && i + 1 < argc) exts = splitExts(argv[++i]);
        }

        if (!fs::exists(asarPath)) {
            throw std::runtime_error("Target asar not found: " + asarPath.string());
        }

        //fs::path backup = asarPath;
        //backup += ".bak";
        //fs::copy_file(asarPath, backup, fs::copy_options::overwrite_existing);

        fs::path tmpDir = fs::temp_directory_path() / ("asar_tool_" + std::to_string((unsigned)std::hash<std::string>{}(asarPath.string())));
        if (fs::exists(tmpDir)) fs::remove_all(tmpDir);

        unpackAsar(asarPath, tmpDir);
        walkReplace(tmpDir, kPatches, all, exts);
        packAsar(tmpDir, asarPath);

        fs::remove_all(tmpDir);
        return 0;
    }
    catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << "\n";
        return 1;
    }
}
